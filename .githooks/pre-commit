#!/bin/sh
# commit 前用 gitleaks 擋密鑰。啟用：在主 clone 跑一次 `git config core.hooksPath .githooks`，
# 這個設定存在共用的 .git/config，所有 worktree 一起生效。規則見 AGENTS.md〈commit 前的檢查〉。
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit：找不到 gitleaks（macOS：brew install gitleaks）。不裝就不能 commit，不是略過。" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner .
