#!/bin/sh
# commit 前用 gitleaks 擋 staged 改動裡的密鑰。啟用方式與「為什麼一定要絕對路徑」只寫在
# AGENTS.md〈commit 前的檢查〉，這裡不留第二份指令。
set -e
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit：找不到 gitleaks（macOS：brew install gitleaks）。不裝就不能 commit，不是略過。" >&2
  exit 1
fi
gitleaks git --pre-commit --staged -v --redact --no-banner .
