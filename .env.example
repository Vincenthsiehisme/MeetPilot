# Gemini API 金鑰（必填，只在 server 端使用）
GEMINI_API_KEY=

# 監聽位址。預設 127.0.0.1（只有本機能連）。
# 要開給區網或外部（例如 0.0.0.0）時，下面兩個 Basic Auth 變數必須都設，否則 server 拒絕啟動。
HOST=127.0.0.1
PORT=3000
MEETPILOT_BASIC_AUTH_USER=
MEETPILOT_BASIC_AUTH_PASSWORD=

# /api/* 每個 IP 每分鐘最多幾次請求。預設 60；長錄音一片 10 分鐘一次請求，正常流程不會撞到。
MEETPILOT_API_RATE_LIMIT=60

# 一期的結構化儲存（SQLite）。預設 data/meetpilot.db（data 已在 .gitignore）。
# 測試用 :memory:。路徑不可寫時 server 直接起不來，不會等到存第一場會才發現。
MEETPILOT_DB=data/meetpilot.db

# 上傳音檔在 server 上的存放目錄。預設 data/audio（data 已在 .gitignore）。
# 音檔在「分析成功」之後才刪；轉錄或分析失敗時保留，供 POST /api/meetings/:id/retry 重跑。
MEETPILOT_AUDIO_DIR=data/audio

# ffmpeg 與 ffprobe 的執行檔路徑。不設就走 PATH 上的 ffmpeg / ffprobe。
# server 端切片靠這兩支，沒安裝時上傳的會議會轉 FAILED，error 裡會指出要安裝 ffmpeg。
MEETPILOT_FFMPEG=
MEETPILOT_FFPROBE=

# Gemini 呼叫紀錄的 JSONL 路徑。預設 logs/llm.jsonl（logs 已在 .gitignore）；設 off 關閉。
# 只記 metadata：model、fallback 第幾個、重試次數、延遲、token 數、錯誤狀態碼。不含逐字稿、提問或回覆內容。
MEETPILOT_LLM_LOG=logs/llm.jsonl

# 轉錄／分析各自可以同時跑幾場會（轉錄分析佇列架構升級）。預設都是 1，沿用升級前完全序列
# 的行為。拆解本身的價值先體現在「失敗互不阻塞、可以獨立重跑」，調高併發是可選的加值。
# MEETPILOT_TRANSCRIPTION_CONCURRENCY=1
# MEETPILOT_ANALYSIS_CONCURRENCY=1

# 同時間最多幾個 Gemini 呼叫在飛（AC-6，轉錄分析佇列架構升級）。預設 2，跟上面兩個併行量的
# 預設值（1+1）對齊：轉錄與分析現在是兩條獨立 queue，可能同時各跑一場會，各自打一次 Gemini，
# 這裡的全域上限擋住「兩條 queue 同時打」這種新併發。要調高前先查實際 Gemini 專案配額，
# 不是憑空的安全值——完全序列的時候，真實 log 就已經在撞 fallback（見 vault 記錄）。
# MEETPILOT_GEMINI_MAX_CONCURRENCY=2

# 切片接縫的破洞修復（W2-2b）。破洞＝有一段音檔沒有人轉過，補要花額外的 Gemini 呼叫。
# off 關閉；預設開啟，因為音檔在分析成功之後就刪了，當下不補就永遠補不回來
# MEETPILOT_SEAM_REPAIR=off
# 一場會最多送幾次額外轉錄（預設 6）。設 0 等於關閉但仍會記錄接縫報告
# MEETPILOT_SEAM_REPAIR_BUDGET=6

# 跨會議關聯（W4）。off 關閉；預設開啟。
# 關掉時會議停在 READY（＝還沒算），不是 LINK_FAILED（＝算了、失敗了），POST /api/meetings/:id/link 回 503。
# 這個開關的存在理由是「關聯算錯時要能立刻停掉，不必改碼重新部署」——錯誤的關聯擺在人面前的
# 每一分鐘都在消耗信任。
# MEETPILOT_LINKING=off

# 會議結論投影到的 Obsidian vault（W5）。預設 ~/MeetPilot Vault。沒有 off 開關：每場會 READY／
# 重新計算關聯之後都會投影一份 markdown，人工修正的地方（人工區）系統只讀不寫。
# 不要設成 AI Memory 那個 vault——那個 vault 的檢查腳本對會議 markdown 有硬衝突，詳情見 README。
# MEETPILOT_VAULT=~/MeetPilot Vault

# 人員名單 CSV 路徑。設了的話，server 啟動時若 people 表還是空的會自動匯入這份檔案
# （跟手動執行 npx tsx scripts/importRoster.ts 是同一套邏輯，只是省得每次重建資料庫都要
# 記得手動下指令）。不設就維持原本行為：完全不動，仍要手動跑 CLI 匯入才能建立會議。
# MEETPILOT_ROSTER_CSV=eval-data/meeting_attendee_static_master_utf8.csv

# gateway 名單文件（{ version: 1, rows }）的路徑，桌面 app 的外殼自己設，網頁版通常不用。
# 設了的話 server 每次啟動都匯入一次（upsert）。跟 MEETPILOT_ROSTER_CSV 只能設一個。
# MEETPILOT_ROSTER_DOCUMENT=/path/to/roster.json
