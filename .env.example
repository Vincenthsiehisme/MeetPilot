# Gemini API 金鑰（必填，只在 server 端使用）
GEMINI_API_KEY=

# 監聽位址。預設 127.0.0.1（只有本機能連）。
# 要開給區網或外部（例如 0.0.0.0）時，下面兩個 Basic Auth 變數必須都設，否則 server 拒絕啟動。
HOST=127.0.0.1
PORT=3000
MEETPILOT_BASIC_AUTH_USER=
MEETPILOT_BASIC_AUTH_PASSWORD=

# /api/* 每個 IP 每分鐘最多幾次請求。預設 60；長錄音一片 10 分鐘一次請求，正常流程不會撞到。
MEETPILOT_API_RATE_LIMIT=60

# Gemini 呼叫紀錄的 JSONL 路徑。預設 logs/llm.jsonl（logs 已在 .gitignore）；設 off 關閉。
# 只記 metadata：model、fallback 第幾個、重試次數、延遲、token 數、錯誤狀態碼。不含逐字稿、提問或回覆內容。
MEETPILOT_LLM_LOG=logs/llm.jsonl
