# Gemini API 金鑰（必填，只在 server 端使用）
GEMINI_API_KEY=

# 監聽位址。預設 127.0.0.1（只有本機能連）。
# 要開給區網或外部（例如 0.0.0.0）時，下面兩個 Basic Auth 變數必須都設，否則 server 拒絕啟動。
HOST=127.0.0.1
PORT=3000
MEETPILOT_BASIC_AUTH_USER=
MEETPILOT_BASIC_AUTH_PASSWORD=

# /api/* 每個 IP 每分鐘最多幾次請求。預設 60；長錄音一片 10 分鐘一次請求，正常流程不會撞到。
MEETPILOT_API_RATE_LIMIT=60

# 一期的結構化儲存（SQLite）。預設 data/meetpilot.db（data 已在 .gitignore）。
# 測試用 :memory:。路徑不可寫時 server 直接起不來，不會等到存第一場會才發現。
MEETPILOT_DB=data/meetpilot.db

# 上傳音檔在 server 上的存放目錄。預設 data/audio（data 已在 .gitignore）。
# 音檔在「分析成功」之後才刪；轉錄或分析失敗時保留，供 POST /api/meetings/:id/retry 重跑。
MEETPILOT_AUDIO_DIR=data/audio

# ffmpeg 與 ffprobe 的執行檔路徑。不設就走 PATH 上的 ffmpeg / ffprobe。
# server 端切片靠這兩支，沒安裝時上傳的會議會轉 FAILED，error 裡會指出要安裝 ffmpeg。
MEETPILOT_FFMPEG=
MEETPILOT_FFPROBE=

# Gemini 呼叫紀錄的 JSONL 路徑。預設 logs/llm.jsonl（logs 已在 .gitignore）；設 off 關閉。
# 只記 metadata：model、fallback 第幾個、重試次數、延遲、token 數、錯誤狀態碼。不含逐字稿、提問或回覆內容。
MEETPILOT_LLM_LOG=logs/llm.jsonl
